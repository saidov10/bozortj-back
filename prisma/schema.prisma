datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String   @unique // validated format: +992XXXXXXXXX
  password     String   // hashed
  role         String   // "ADMIN", "SELLER", "BUYER"
  name         String   // Buyer name, Admin name, or Seller Contact name
  avatarUrl    String?  // Profile picture (optional)
  isBlocked    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Telegram notification channel (feature: Telegram bot)
  telegramChatId   String?  @unique // linked Telegram chat id; notifications are mirrored here
  telegramLinkCode String?  @unique // one-time code the user sends to the bot to link their account

  // Seller specific
  shopProfile ShopProfile?

  // Buyer specific
  cartItems     CartItem[]
  wishlist      WishlistItem[]
  reviews       Review[]
  orders        Order[]
  notifications Notification[]
  reportsFiled  Report[]       @relation("Reporter")
  addresses     Address[]
  priceOffers   PriceOffer[]   @relation("BuyerOffers")
  pushSubscriptions PushSubscription[]
  questionsAsked ProductQuestion[]

  // Chat relation
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
}

model ShopProfile {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopName         String    @unique
  description      String
  autoReplyText    String?
  autoReplyEnabled Boolean   @default(false)
  categoryId       String?   // The single category this shop is allowed to sell in
  category         Category? @relation(fields: [categoryId], references: [id])
  // Delivery pricing — the seller sets their own flat delivery fee, with an
  // optional order value above which delivery is free.
  deliveryFee            Float   @default(0)
  freeDeliveryThreshold  Float?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  products    Product[]
  orderItems  OrderItem[]
  coupons     Coupon[]
  reports     Report[]
  flashSales  FlashSale[]
  priceOffers PriceOffer[]
}

model Category {
  id            String        @id @default(uuid())
  name          String        @unique
  subcategories Subcategory[]
  products      Product[]
  shops         ShopProfile[]
}

model Subcategory {
  id         String    @id @default(uuid())
  name       String
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([name, categoryId])
}

model Brand {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]
}

model Color {
  id       String           @id @default(uuid())
  name     String           @unique
  hexCode  String?          // e.g. "#FF0000" for rendering color swatches
  products Product[]
  variants ProductVariant[]
}

model Product {
  id            String         @id @default(uuid())
  shopId        String
  shop          ShopProfile    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name          String
  description   String
  price         Float
  discountPrice Float?
  isOnDiscount  Boolean        @default(false)
  colorId       String         // Fallback default color
  color         Color          @relation(fields: [colorId], references: [id])
  size          String         // Fallback default size
  stockQuantity Int            // Fallback total stock (sum of variants)
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id])
  subcategoryId String?
  subcategory   Subcategory?   @relation(fields: [subcategoryId], references: [id])
  brandId       String
  brand         Brand          @relation(fields: [brandId], references: [id])
  attributes    Json?          // Category-specific specifications (key-value), e.g. { "ram": "8GB", "storage": "256GB" }
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Cached AI summary of reviews (regenerated when review count grows)
  reviewSummary      Json?      // { pros: string[], cons: string[], verdict: string }
  reviewSummaryAt    DateTime?
  reviewSummaryCount Int?       // number of reviewed comments when the summary was generated

  images        ProductImage[]
  wishlistItems WishlistItem[]
  reviews       Review[]
  variants      ProductVariant[]
  reports       Report[]
  flashSales    FlashSale[]
  priceOffers   PriceOffer[]
  questions     ProductQuestion[]
}

model ProductVariant {
  id            String      @id @default(uuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorId       String
  color         Color       @relation(fields: [colorId], references: [id])
  size          String
  stockQuantity Int
  price         Float?      // If variant has specific price, otherwise fallback to Product.price
  discountPrice Float?      // Variant specific discount price
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  cartItems     CartItem[]
  orderItems    OrderItem[]
}

model ProductImage {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  thumbnailUrl String?  // small resized copy for fast list rendering on slow connections
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String   // e.g. "Home", "Office"
  city       String
  street     String
  building   String
  apartment  String?
  postalCode String?
  landmark   String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  orders Order[]
}

model CartItem {
  id                String         @id @default(uuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId         String
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity          Int            @default(1)
  abandonedNotified Boolean        @default(false) // true once we've reminded the buyer about this abandoned item
  createdAt         DateTime       @default(now())
}

model FlashSale {
  id         String      @id @default(uuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  shopId     String
  shop       ShopProfile @relation(fields: [shopId], references: [id], onDelete: Cascade)
  salePrice  Float       // time-limited price (must be below the product's normal price)
  startsAt   DateTime
  endsAt     DateTime
  soldCount  Int         @default(0) // units sold during the sale — broadcast live for urgency
  stockLimit Int?        // optional cap on units offered at the sale price
  createdAt  DateTime    @default(now())
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique
  discountType  String // "PERCENT" or "FIXED"
  discountValue Float
  minPurchase   Float        @default(0)
  maxUsage      Int?
  usedCount     Int          @default(0)
  expiryDate    DateTime?
  shopId        String?
  shop          ShopProfile? @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // When set, only this buyer may redeem the coupon. Used for accepted price
  // offers (bargaining) so the negotiated price is locked to the one buyer.
  assignedUserId String?
  createdAt     DateTime     @default(now())

  orders Order[]
}

model Order {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     String         // "PENDING", "PROCESSING", "SHIPPED", "DELIVERED", "CANCELLED"
  totalPrice Float
  couponId   String?
  coupon     Coupon?        @relation(fields: [couponId], references: [id], onDelete: SetNull)
  addressId  String?
  address    Address?       @relation(fields: [addressId], references: [id], onDelete: SetNull)
  paymentMethod String       @default("COD") // "COD" (cash on delivery) or "ONLINE"
  deliveryFee   Float        @default(0) // sum of each shop's delivery fee at checkout
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  items      OrderItem[]
  refund     RefundRequest?
  statusHistory OrderStatusHistory[]
  payment    Payment?
}

model OrderStatusHistory {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String   // "PENDING", "PROCESSING", "SHIPPED", "DELIVERED", "CANCELLED"
  note      String?
  createdAt DateTime @default(now())
}

model OrderItem {
  id        String         @id @default(uuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  price     Float          // Checkout price (takes discount into account)
  shopId    String
  shop      ShopProfile    @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model RefundRequest {
  id          String        @id @default(uuid())
  orderId     String        @unique
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reason      String
  status      String        @default("PENDING") // "PENDING", "APPROVED", "REJECTED", "DISPUTED", "RESOLVED"
  explanation String?
  createdAt   DateTime      @default(now())
  images      RefundImage[]
}

model RefundImage {
  id              String        @id @default(uuid())
  refundRequestId String
  refundRequest   RefundRequest @relation(fields: [refundRequestId], references: [id], onDelete: Cascade)
  url             String
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Report {
  id         String       @id @default(uuid())
  reporterId String
  reporter   User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  shopId     String?
  shop       ShopProfile? @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  reason     String
  status     String       @default("PENDING") // "PENDING", "RESOLVED", "DISMISSED"
  createdAt  DateTime     @default(now())
}

model Review {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId     String
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating        Int // 1-5 stars
  comment       String?
  sellerReply   String?
  sellerReplyAt DateTime?
  createdAt     DateTime      @default(now())
  images        ReviewImage[]
}

model ReviewImage {
  id       String @id @default(uuid())
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  url      String
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  text       String
  createdAt  DateTime @default(now())
  isRead     Boolean  @default(false)
}

// Price bargaining ("Нарх пешниҳод кун") — a buyer proposes a price for a
// product; the seller accepts, rejects, or counter-offers. On acceptance a
// single-use, buyer-locked coupon is generated so the buyer checks out at the
// agreed price.
model PriceOffer {
  id           String      @id @default(uuid())
  productId    String
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyerId      String
  buyer        User        @relation("BuyerOffers", fields: [buyerId], references: [id], onDelete: Cascade)
  shopId       String
  shop         ShopProfile @relation(fields: [shopId], references: [id], onDelete: Cascade)
  offeredPrice Float
  message      String?
  status       String      @default("PENDING") // PENDING, ACCEPTED, REJECTED, COUNTERED, EXPIRED
  counterPrice Float?      // seller's counter-offer, when status = COUNTERED
  couponCode   String?     // single-use coupon issued on acceptance
  agreedPrice  Float?      // final agreed unit price once accepted
  createdAt    DateTime    @default(now())
  respondedAt  DateTime?
  expiresAt    DateTime    // offer / issued coupon valid until this time
}

// Product Q&A ("Савол-ҷавоб") — a buyer asks a public question on a product
// page; the seller answers. Answered questions stay public so future buyers see
// them, turning one answer into many sales.
model ProductQuestion {
  id         String    @id @default(uuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   String
  answer     String?
  answeredAt DateTime?
  createdAt  DateTime  @default(now())
}

// Web Push (PWA) subscription — one row per browser/device push endpoint.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String   // client public key
  auth      String   // client auth secret
  createdAt DateTime @default(now())
}

// Payment record for an order. Provider-agnostic scaffold: works today with
// "COD" (cash on delivery) and a "MOCK" online provider, and is ready to plug
// in a real Tajik gateway (Alif Mobi / DC / Korti Milli) once merchant
// credentials are available.
model Payment {
  id        String    @id @default(uuid())
  orderId   String    @unique
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider  String    // "COD", "MOCK", "ALIF", "DC"
  amount    Float
  status    String    @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  reference String?   // provider-side transaction id
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
